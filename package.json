{
  "name": "@horizon-ark-studio/arkware",
  "version": "0.2.3",
  "description": "Package any SPA as a thin native shell. One `arkware` CLI: `arkware android emit-flavor` authors Gradle config for main's Android WebView shell, `arkware linux build` scaffolds and cmake-builds main's real native C shell (GTK + WebKitGTK, Linux desktop only for now).",
  "license": "GPL-3.0-or-later",
  "author": "Horizon ARK Studio",
  "homepage": "https://github.com/Horizon-ARK-Studio/ARKware#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Horizon-ARK-Studio/ARKware.git"
  },
  "bugs": {
    "url": "https://github.com/Horizon-ARK-Studio/ARKware/issues"
  },
  "type": "commonjs",
  "bin": {
    "arkware": "./bin/arkware.js"
  },
  "files": [
    "bin",
    "src",
    "scripts/sync-from-main.js",
    "scripts/ram-dist.sh",
    "arkware.config.example.js",
    "arkware-runtime.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync": "node scripts/sync-from-main.js",
    "prepare": "node scripts/sync-from-main.js || true"
  },
  "keywords": [
    "arkware",
    "spa",
    "native-shell",
    "webview",
    "pwa",
    "desktop",
    "gtk",
    "webkitgtk",
    "linux",
    "android"
  ]
}
