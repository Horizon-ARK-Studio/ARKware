{
  "applicationId": "__APP_ID__",
  "version": "__APP_VERSION__",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "__DOCUMENT_ROOT__",
  "url": "__URL__",
  "enableServer": __ENABLE_SERVER__,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "events.*"
  ],
  "modes": {
    "window": {
      "title": "__WINDOW_TITLE__",
      "width": 1200,
      "height": 800,
      "minWidth": 400,
      "minHeight": 300,
      "icon": "__ICON__",
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "__BINARY_NAME__",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.4.0",
    "clientVersion": "3.12.0"
  }
}
